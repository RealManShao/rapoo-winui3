<Window
    x:Class="Rapoo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Rapoo.App.ViewModels"
    Title="Rapoo Control">
    <Grid
        x:Name="Root"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RequestedTheme="Light">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Padding="24,32,20,24"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="6">
                    <Image
                        Width="140"
                        Height="40"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Rapoo"
                        Source="ms-appx:///Assets/RapooLogo.svg"
                        Stretch="Uniform" />
                    <TextBlock
                        CharacterSpacing="180"
                        FontSize="10"
                        Foreground="{StaticResource BrandBrush}"
                        Text="MOUSE CONTROL" />
                    <Border
                        Margin="0,38,0,0"
                        Padding="12"
                        Background="{StaticResource BrandSubtleBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon
                                    FontSize="17"
                                    Foreground="{StaticResource BrandBrush}"
                                    Glyph="&#xE713;" />
                                <TextBlock FontWeight="SemiBold" Text="性能设置" />
                            </StackPanel>
                        </StackPanel>

                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="10">
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="OpenFolder_Click"
                        Content="打开配置目录"
                        FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer
            x:Name="DashboardPage"
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1120"
                Padding="32,28,32,32"
                HorizontalAlignment="Stretch"
                Spacing="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="设备性能" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <ProgressRing
                            Width="22"
                            Height="22"
                            IsActive="{Binding Busy}" />
                        <Button
                            Click="Connect_Click"
                            Content="{Binding ConnectLabel}"
                            IsEnabled="{Binding CanConnect}" />
                    </StackPanel>
                </Grid>
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{Binding Message}"
                    Severity="{Binding Severity}" />
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Foreground="{StaticResource BrandBrush}" Glyph="&#xE962;" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding ConnectionText}" />
                            </StackPanel>
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="VT Gen1 (3950)" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding ConnectionDetail}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource Caption}" Text="电量" />
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrandBrush}"
                                Text="{Binding BatteryText}" />
                            <ProgressBar
                                Foreground="{StaticResource BrandBrush}"
                                Maximum="100"
                                Value="{Binding BatteryValue}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding BatteryDetail}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource Caption}" Text="当前 DPI" />
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="{Binding CurrentDpi}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource Caption}" Text="当前回报率" />
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="{Binding CurrentPollingRate}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="DPI" />
                            <Border
                                Grid.Column="1"
                                Padding="10,6"
                                VerticalAlignment="Top"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <TextBlock FontSize="12" Text="{Binding EnabledCount}" />
                            </Border>
                        </Grid>
                        <ToggleSwitch
                            IsEnabled="{Binding CanEdit}"
                            IsOn="{Binding IndependentDpi, Mode=TwoWay}"
                            OffContent="独立 X / Y DPI"
                            OnContent="独立 X / Y DPI" />
                        <ItemsControl IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DpiStageViewModel">
                                    <Grid
                                        Padding="8"
                                        Background="{Binding RowBackground}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        ColumnSpacing="16"
                                        CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrandBrush}"
                                            Text="{Binding Number}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                            <TextBlock Text="DPI 档位" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Number}" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrandBrush}"
                                                Text="{Binding CurrentIndicator}" />
                                        </StackPanel>
                                        <NumberBox
                                            Grid.Column="2"
                                            AutomationProperties.Name="{Binding AccessibleLabel}"
                                            Header="X DPI"
                                            LargeChange="500"
                                            Maximum="45000"
                                            Minimum="50"
                                            SmallChange="50"
                                            SpinButtonPlacementMode="Compact"
                                            ValidationMode="InvalidInputOverwritten"
                                            Value="{Binding Dpi, Mode=TwoWay}" />
                                        <NumberBox
                                            Grid.Column="3"
                                            AutomationProperties.Name="{Binding YAccessibleLabel}"
                                            Header="Y DPI"
                                            IsEnabled="{Binding Independent}"
                                            LargeChange="500"
                                            Maximum="45000"
                                            Minimum="50"
                                            SmallChange="50"
                                            SpinButtonPlacementMode="Compact"
                                            ValidationMode="InvalidInputOverwritten"
                                            Value="{Binding DpiY, Mode=TwoWay}" />
                                        <ToggleSwitch
                                            Grid.Column="4"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding ToggleLabel}"
                                            IsOn="{Binding Enabled, Mode=TwoWay}"
                                            OffContent="关闭"
                                            OnContent="启用" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource Caption}"
                                Text="{Binding DpiDisplayStatus}" />
                            <Button
                                Grid.Column="1"
                                Click="ApplyDpi_Click"
                                Content="应用 DPI"
                                IsEnabled="{Binding CanApplyDpi}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="回报率" />
                        </StackPanel>
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="回报率"
                                DisplayMemberPath="Label"
                                IsEnabled="{Binding CanEdit}"
                                ItemsSource="{Binding Rates}"
                                SelectedItem="{Binding SelectedRate, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource Caption}"
                                Text="{Binding RateHint}" />
                            <Button
                                Grid.Column="2"
                                Click="ApplyRate_Click"
                                Content="应用回报率"
                                IsEnabled="{Binding CanApplyRate}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding RateStatus}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="传感器与响应" />
                        <TextBlock
                            Style="{StaticResource Caption}"
                            Text="{Binding SensorHint}"
                            TextWrapping="Wrap" />
                        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{Binding CanEditSensors}">
                            <Grid ColumnSpacing="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="18">
                                    <ToggleSwitch
                                        Header="移动同步"
                                        IsOn="{Binding Sensor.MotionSync, Mode=TwoWay}"
                                        OffContent="关闭"
                                        OnContent="开启" />
                                    <ToggleSwitch
                                        Header="直线修正"
                                        IsOn="{Binding Sensor.LinearCorrection, Mode=TwoWay}"
                                        OffContent="关闭"
                                        OnContent="开启" />
                                    <ToggleSwitch
                                        Header="波纹修正"
                                        IsOn="{Binding Sensor.RippleCorrection, Mode=TwoWay}"
                                        OffContent="关闭"
                                        OnContent="开启" />
                                    <ToggleSwitch
                                        Header="玻璃追踪"
                                        IsOn="{Binding Sensor.GlassTracking, Mode=TwoWay}"
                                        OffContent="关闭"
                                        OnContent="开启" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="18">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            Header="按下去抖（毫秒）"
                                            ItemsSource="{Binding DebounceOptions}"
                                            SelectedItem="{Binding Sensor.PressMs, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Header="抬起去抖（毫秒）"
                                            ItemsSource="{Binding DebounceOptions}"
                                            SelectedItem="{Binding Sensor.ReleaseMs, Mode=TwoWay}" />
                                    </Grid>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberPath="Label"
                                        Header="抬升高度（LOD）"
                                        ItemsSource="{Binding LodOptions}"
                                        SelectedItem="{Binding Sensor.Lod, Mode=TwoWay}" />
                                    <NumberBox
                                        Header="休眠等待（分钟）"
                                        Maximum="120"
                                        Minimum="5"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding Sensor.SleepMinutes, Mode=TwoWay}" />
                                    <NumberBox
                                        Header="传感器角度（度）"
                                        Maximum="30"
                                        Minimum="-30"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding Sensor.Angle, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </ContentControl>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource Caption}"
                                Text="{Binding SensorStatus}"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Column="1"
                                Click="ApplySensors_Click"
                                Content="应用参数"
                                IsEnabled="{Binding CanApplySensors}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="通信日志"
                    IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource Caption}" Text="TX：Output BA 写入　RX：Input BA 应答　BAT：电量报告" />
                        <TextBlock Style="{StaticResource Caption}" Text="仅保留最近 128 条不同记录；相同内容更新为最新一条，不写入磁盘。" />
                        <ScrollViewer
                            Height="200"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11"
                                IsTextSelectionEnabled="True"
                                Text="{Binding LogText}" />
                        </ScrollViewer>
                        <Button
                            HorizontalAlignment="Right"
                            Click="ClearLog_Click"
                            Content="清空界面日志" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
