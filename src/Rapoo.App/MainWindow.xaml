<Window x:Class="Rapoo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Rapoo.App.ViewModels"
    Title="Rapoo Control">
    <Grid x:Name="Root" RequestedTheme="Light" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="24,32,20,24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="6">
                    <Image Source="ms-appx:///Assets/RapooLogo.svg" Width="140" Height="40" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Rapoo" />
                    <TextBlock Text="MOUSE CONTROL" FontSize="10" CharacterSpacing="180" Foreground="{StaticResource BrandBrush}" />
                    <Border Margin="0,38,0,0" Background="{StaticResource BrandSubtleBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE713;" FontSize="17" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Text="性能设置" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="VT Gen1 (3950)" Margin="12,10,0,0" Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="10">
                    <TextBlock Text="WinUI 3 / C# · v1.0" Style="{StaticResource Caption}" />
                    <Button Content="打开配置目录" Click="OpenFolder_Click" FontSize="12" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32,28,32,32" Spacing="20" MaxWidth="1120" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="设备性能" FontSize="30" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing IsActive="{Binding Busy}" Width="22" Height="22" />
                        <Button Content="{Binding ConnectLabel}" IsEnabled="{Binding CanConnect}" Click="Connect_Click" />
                    </StackPanel>
                </Grid>
                <InfoBar IsOpen="True" IsClosable="False" Severity="{Binding Severity}" Message="{Binding Message}" />
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE962;" Foreground="{StaticResource BrandBrush}" /><TextBlock Text="{Binding ConnectionText}" FontWeight="SemiBold" /></StackPanel>
                            <TextBlock Text="VT Gen1 (3950)" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConnectionDetail}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="电量" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding BatteryText}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" />
                            <ProgressBar Value="{Binding BatteryValue}" Maximum="100" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Text="{Binding BatteryDetail}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="当前 DPI" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding CurrentDpi}" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="当前回报率" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding CurrentPollingRate}" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6"><TextBlock Text="DPI" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding DpiHint}" Style="{StaticResource Caption}" /></StackPanel>
                            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6" VerticalAlignment="Top"><TextBlock Text="{Binding EnabledCount}" FontSize="12" /></Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Stages}" IsEnabled="{Binding CanEdit}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DpiStageViewModel">
                                    <Grid Padding="8" ColumnSpacing="16" Background="{Binding RowBackground}" CornerRadius="6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10"><TextBlock Text="DPI 档位" /><TextBlock Text="{Binding Number}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding CurrentIndicator}" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold" /></StackPanel>
                                        <NumberBox Grid.Column="2" Value="{Binding Dpi, Mode=TwoWay}" Minimum="50" Maximum="45000" SmallChange="50" LargeChange="500" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" AutomationProperties.Name="{Binding AccessibleLabel}" />
                                        <ToggleSwitch Grid.Column="3" IsOn="{Binding Enabled, Mode=TwoWay}" OnContent="启用" OffContent="关闭" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding ToggleLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DpiStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="应用 DPI" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding CanApplyDpi}" Click="ApplyDpi_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6"><TextBlock Text="回报率" Style="{StaticResource SectionTitle}" /></StackPanel>
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Rates}" SelectedItem="{Binding SelectedRate, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="回报率" />
                            <TextBlock Grid.Column="1" Text="{Binding RateHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="应用回报率" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding CanApplyRate}" Click="ApplyRate_Click" />
                        </Grid>
                        <TextBlock Text="{Binding RateStatus}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Expander Header="通信日志" IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock Text="TX：Output BA 写入　RX：Input BA 应答　BAT：电量报告" Style="{StaticResource Caption}" />
                        <TextBlock Text="仅保留最近 128 条不同记录；相同内容更新为最新一条，不写入磁盘。" Style="{StaticResource Caption}" />
                        <ScrollViewer Height="200" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding LogText}" FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True" /></ScrollViewer>
                        <Button Content="清空界面日志" Click="ClearLog_Click" HorizontalAlignment="Right" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
